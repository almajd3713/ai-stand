# Copy this file to .env and fill it in. .env is gitignored: it never reaches GitHub.

# --- The local LLM server (the Mac on the day) ---
# Ollama:     http://<mac-ip>:11434     (start it with OLLAMA_HOST=0.0.0.0 so other laptops can reach it)
# llama.cpp:  http://<mac-ip>:8080
LLM_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b

# --- Jailbreak the Guardian: one password per level ---
# Single words, 7+ letters, UPPERCASE. Set them on the day; leave blank for random ones.
JB_PASSWORD_1=
JB_PASSWORD_2=
JB_PASSWORD_3=
JB_PASSWORD_4=
JB_PASSWORD_5=
JB_PASSWORD_6=

# --- Human or Bot: where the bot claims to study (makes it more believable) ---
TURING_PLACE=
